# Credenciais do app do Discord para o login local (https://discord.com/developers/applications)
# Redirect a cadastrar no Discord: http://127.0.0.1:54321/auth/v1/callback
SUPABASE_AUTH_EXTERNAL_DISCORD_CLIENT_ID=""
SUPABASE_AUTH_EXTERNAL_DISCORD_SECRET=""

# Credenciais do cliente OAuth do Google para o login local (https://console.cloud.google.com/apis/credentials)
# Redirect a cadastrar no Google: http://127.0.0.1:54321/auth/v1/callback
SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_ID=""
SUPABASE_AUTH_EXTERNAL_GOOGLE_SECRET=""
