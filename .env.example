# Supabase local (bun run db:start). A chave é a PUBLISHABLE_KEY mostrada em: bun run db:status
SUPABASE_URL="http://127.0.0.1:54321"
SUPABASE_KEY=""

# Só no servidor (usada para excluir conta). Local: SECRET_KEY do `bun run db:status`.
